<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_comisiones" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="df013db5-f76e-44d3-b0df-bcbc46d93160">
    <parameter name="VALOR_BY_INSTITUTO" class="java.lang.String"/>
    <parameter name="OP_BY_INSTITUTO" class="java.lang.String"/>
    <parameter name="VALOR_BY_CARRERA" class="java.lang.String"/>
    <parameter name="OP_BY_CARRERA" class="java.lang.String"/>
    <parameter name="OP_NOMBRE" class="java.lang.String"/>
    <parameter name="OP_CODIGO" class="java.lang.String"/>
    <parameter name="VALOR_CODIGO" class="java.lang.String"/>
    <parameter name="OP_MATERIA" class="java.lang.String"/>
    <parameter name="VALOR_MATERIA" class="java.lang.String"/>
    <parameter name="OP_HORAS_TOTALES" class="java.lang.String"/>
    <parameter name="VALOR_HORAS_TOTALES" class="java.lang.String"/>
    <parameter name="OP_HORA_INICIO" class="java.lang.String"/>
    <parameter name="OP_HORA_FIN" class="java.lang.String"/>
    <parameter name="VALOR_HORA_INICIO" class="java.lang.String"/>
    <parameter name="VALOR_HORA_FIN" class="java.lang.String"/>
    <parameter name="VALOR_ESTADO" class="java.lang.String"/>
    <parameter name="VALOR_TURNO" class="java.lang.String"/>
    <parameter name="VALOR_DIA_SEMANA" class="java.lang.String"/>
    <parameter name="OP_ANIO" class="java.lang.String"/>
    <parameter name="VALOR_ANIO" class="java.lang.String"/>
    <parameter name="VALOR_MODALIDAD" class="java.lang.String"/>
    <parameter name="OP_AULA" class="java.lang.String"/>
    <parameter name="VALOR_AULA" class="java.lang.String"/>
	<parameter name="logoPath" class="java.lang.String"/>
<queryString>
        <![CDATA[SELECT 
    c.id,
    c.codigo, 
    m.nombre AS nombre_materia, 
    m.cuatrimestre AS cuatrimestre_carrera,
    c.horas_totales, 
    c.horas_teoricas, 
    c.horas_practicas,
    c.anio, 
    c.modalidad, 
    c.sede,
    c.turno,
    STRING_AGG(DISTINCT h.dia_semana || ': ' || TO_CHAR(h.hora_inicio, 'HH24:MI') || ' a ' || TO_CHAR(h.hora_fin, 'HH24:MI'), ' / ') AS cronograma,
    STRING_AGG(DISTINCT d2.nombre || ' ' || d2.apellido, ', ') AS equipo_docente
FROM comisiones c
JOIN materias m ON c.id_materia = m.id 
LEFT JOIN horarios h ON h.comision_id = c.id 
LEFT JOIN dictas d ON d.comision_id = c.id
LEFT JOIN cargos c2 ON c2.id = d.cargo_id 
LEFT JOIN docentes d2 ON c2.docente_id = d2.id
LEFT JOIN plan_materia pm ON m.id = pm.materia_id
LEFT JOIN planes p ON pm.plan_id = p.id
LEFT JOIN carreras carr ON p.carrera_id = carr.id
WHERE 1=1
AND ($P{OP_BY_INSTITUTO} IS NULL OR ($P{OP_BY_INSTITUTO} = 'equals' AND carr.instituto_id = CAST($P{VALOR_BY_INSTITUTO} AS INTEGER)) OR ($P{OP_BY_INSTITUTO} = 'not_equals' AND carr.instituto_id != CAST($P{VALOR_BY_INSTITUTO} AS INTEGER)))
AND ($P{OP_BY_CARRERA} IS NULL OR ($P{OP_BY_CARRERA} = 'equals' AND carr.id = CAST($P{VALOR_BY_CARRERA} AS INTEGER)) OR ($P{OP_BY_CARRERA} = 'not_equals' AND carr.id != CAST($P{VALOR_BY_CARRERA} AS INTEGER)))
AND ($P{OP_CODIGO} IS NULL OR ($P{OP_CODIGO} = 'contains' AND c.codigo ILIKE '%' || $P{VALOR_CODIGO} || '%') OR ($P{OP_CODIGO} = 'equals' AND c.codigo = $P{VALOR_CODIGO}))
AND ($P{OP_MATERIA} IS NULL OR ($P{OP_MATERIA} = 'contains' AND m.nombre ILIKE '%' || $P{VALOR_MATERIA} || '%') OR ($P{OP_MATERIA} = 'equals' AND m.nombre = $P{VALOR_MATERIA}))
AND ($P{OP_AULA} IS NULL OR ($P{OP_AULA} = 'contains' AND h.aula ILIKE '%' || $P{VALOR_AULA} || '%') OR ($P{OP_AULA} = 'equals' AND h.aula = $P{VALOR_AULA}))   
AND ($P{OP_ANIO} IS NULL OR ($P{OP_ANIO} = 'equals' AND c.anio = CAST($P{VALOR_ANIO} AS INTEGER) OR $P{OP_ANIO} = 'greater' AND c.anio > CAST($P{VALOR_ANIO} AS INTEGER) OR $P{OP_ANIO} = 'less' AND c.anio < CAST($P{VALOR_ANIO} AS INTEGER)))
AND ($P{OP_HORAS_TOTALES} IS NULL OR ($P{OP_HORAS_TOTALES} = 'equals' AND c.horas_totales = CAST($P{VALOR_HORAS_TOTALES} AS INTEGER) OR $P{OP_HORAS_TOTALES} = 'greater' AND c.horas_totales > CAST($P{VALOR_HORAS_TOTALES} AS INTEGER) OR $P{OP_HORAS_TOTALES} = 'less' AND c.horas_totales < CAST($P{VALOR_HORAS_TOTALES} AS INTEGER)))
AND ($P{VALOR_DIA_SEMANA} IS NULL OR h.dia_semana = $P{VALOR_DIA_SEMANA})
AND ($P{VALOR_TURNO} IS NULL OR c.turno = $P{VALOR_TURNO})
AND ($P{VALOR_MODALIDAD} IS NULL OR c.modalidad = $P{VALOR_MODALIDAD})
AND ($P{OP_HORA_INICIO} IS NULL OR ($P{OP_HORA_INICIO} = 'greater' AND h.hora_inicio >= CAST($P{VALOR_HORA_INICIO} AS TIME) OR $P{OP_HORA_INICIO} = 'less' AND h.hora_inicio <= CAST($P{VALOR_HORA_INICIO} AS TIME) OR $P{OP_HORA_INICIO} = 'equals' AND h.hora_inicio = CAST($P{VALOR_HORA_INICIO} AS TIME)))
AND ($P{OP_HORA_FIN} IS NULL OR ($P{OP_HORA_FIN} = 'greater' AND h.hora_fin >= CAST($P{VALOR_HORA_FIN} AS TIME) OR $P{OP_HORA_FIN} = 'less' AND h.hora_fin <= CAST($P{VALOR_HORA_FIN} AS TIME) OR $P{OP_HORA_FIN} = 'equals' AND h.hora_fin = CAST($P{VALOR_HORA_FIN} AS TIME)))
AND ($P{VALOR_ESTADO} IS NULL OR c.estado = ($P{VALOR_ESTADO}::int::boolean))
GROUP BY c.id, c.codigo, m.nombre, m.cuatrimestre, c.horas_totales, c.horas_teoricas, c.horas_practicas, c.anio, c.modalidad, c.sede, c.turno, c.estado
ORDER BY c.codigo ASC;]]>
    </queryString>

    <field name="id" class="java.lang.Long"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="nombre_materia" class="java.lang.String"/>
    <field name="cuatrimestre_carrera" class="java.lang.Integer"/>
    <field name="horas_totales" class="java.lang.Integer"/>
    <field name="horas_teoricas" class="java.lang.Integer"/>
    <field name="horas_practicas" class="java.lang.Integer"/>
    <field name="anio" class="java.lang.Integer"/>
    <field name="modalidad" class="java.lang.String"/>
    <field name="sede" class="java.lang.String"/>
    <field name="turno" class="java.lang.String"/>
    <field name="cronograma" class="java.lang.String"/>
    <field name="equipo_docente" class="java.lang.String"/>

