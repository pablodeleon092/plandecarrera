<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 5.2.0  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ReporteMaterias" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b3f2a918-47f6-4560-b8b6-75056d20b0b6">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Plandecarrera"/>
	<parameter name="OP_CUATRIMESTRE" class="java.lang.String"/>
	<parameter name="VALOR_CUATRIMESTRE" class="java.lang.String"/>
	<parameter name="OP_CODIGO" class="java.lang.String"/>
	<parameter name="VALOR_CODIGO" class="java.lang.String"/>
	<parameter name="OP_REGIMEN" class="java.lang.String"/>
	<parameter name="VALOR_REGIMEN" class="java.lang.String"/>
	<parameter name="OP_ESTADO" class="java.lang.String"/>
	<parameter name="VALOR_ESTADO" class="java.lang.String"/>
	<parameter name="logoPath" class="java.lang.String"/>
	<parameter name="OP_HORAS_SEMANALES" class="java.lang.String"/>
	<parameter name="VALOR_HORAS_SEMANALES" class="java.lang.String"/>
	<parameter name="OP_INSTITUTO" class="java.lang.String"/>
	<parameter name="VALOR_INSTITUTO" class="java.lang.String"/>
	<parameter name="OP_CARRERA" class="java.lang.String"/>
	<parameter name="VALOR_CARRERA" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    m.id,
    m.nombre,
    m.codigo,
    m.regimen,
    m.horas_semanales,
    m.horas_totales,
    m.estado,
    i.nombre AS instituto_nombre,
    string_agg(DISTINCT c.nombre, ', ') AS carreras_asociadas,
    COUNT(DISTINCT com.id) AS num_comisiones
FROM materias m
LEFT JOIN plan_materia pm ON pm.materia_id = m.id
LEFT JOIN planes p ON p.id = pm.plan_id
LEFT JOIN carreras c ON c.id = p.carrera_id
LEFT JOIN institutos i ON i.id = c.instituto_id
LEFT JOIN comisiones com ON com.id_materia = m.id
WHERE
(
    $P{OP_CODIGO} IS NULL
    OR ($P{OP_CODIGO} = 'contains' AND m.codigo ILIKE '%' || $P{VALOR_CODIGO} || '%')
    OR ($P{OP_CODIGO} = 'equals' AND m.codigo = $P{VALOR_CODIGO})
)

AND
(
    $P{OP_REGIMEN} IS NULL
    OR ($P{OP_REGIMEN} = 'equals' AND m.regimen = $P{VALOR_REGIMEN})
)

AND
(
    $P{OP_ESTADO} IS NULL
    OR ($P{OP_ESTADO} = 'equals' AND m.estado = CAST($P{VALOR_ESTADO} AS BOOLEAN))
)

AND
(
    $P{OP_CUATRIMESTRE} IS NULL
    OR ($P{OP_CUATRIMESTRE} = 'equals' AND m.cuatrimestre = CAST($P{VALOR_CUATRIMESTRE} AS INTEGER))
)

AND
(
    $P{OP_HORAS_SEMANALES} IS NULL
    OR ($P{OP_HORAS_SEMANALES} = 'equals' AND m.horas_semanales = CAST($P{VALOR_HORAS_SEMANALES} AS INTEGER))
)

AND
(
    $P{OP_INSTITUTO} IS NULL
    OR ($P{OP_INSTITUTO} = 'equals' AND i.id = CAST($P{VALOR_INSTITUTO} AS INTEGER))
)

AND
(
    $P{OP_CARRERA} IS NULL
    OR ($P{OP_CARRERA} = 'equals' AND c.id = CAST($P{VALOR_CARRERA} AS INTEGER))
)

GROUP BY
    m.id,
    m.nombre,
    m.codigo,
    m.regimen,
    m.horas_semanales,
    m.horas_totales,
    m.estado,
    i.id,
    i.nombre

ORDER BY m.nombre ASC]]>
	</queryString>
