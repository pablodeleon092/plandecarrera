    <parameter name="OP_DE_INSTITUTO" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="VALOR_DE_INSTITUTO" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="OP_DE_CARRERA" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="VALOR_DE_CARRERA" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

    <parameter name="OP_HORAS" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="VALOR_HORAS" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="MIN_HORAS" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="MAX_HORAS" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="OP_LEGAJO" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="VALOR_LEGAJO" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="MIN_LEGAJO" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="MAX_LEGAJO" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="OP_CARGO" class="java.lang.String"/>
    <parameter name="VALOR_CARGO" class="java.lang.String"/>
    <parameter name="OP_DEDICACION" class="java.lang.String"/>
    <parameter name="VALOR_DEDICACION" class="java.lang.Integer"/>
    <parameter name="OP_MODALIDAD" class="java.lang.String"/>
    <parameter name="VALOR_MODALIDAD" class="java.lang.String"/>
    <parameter name="OP_MATERIA" class="java.lang.String"/>
    <parameter name="VALOR_MATERIA" class="java.lang.String"/>
    <parameter name="OP_NOMBRE" class="java.lang.String"/>
    <parameter name="VALOR_NOMBRE" class="java.lang.String"/>
	<parameter name="logoPath" class="java.lang.String"/>
    <queryString>
        <![CDATA[SELECT 
    d.id,
    d.legajo,
    d.apellido || ', ' || d.nombre AS docente_nombre_completo,
    d.modalidad_desempeño,
    d.carga_horaria,
    STRING_AGG(DISTINCT mat.nombre, ' / ') AS lista_materias,
    STRING_AGG(DISTINCT (carg.nombre || ' (' || COALESCE(ded.nombre, 'S/D') || ')'), ' | ') AS lista_cargos
FROM docentes d
LEFT JOIN dictas dict ON d.id = dict.docente_id
LEFT JOIN comisiones com ON dict.comision_id = com.id
LEFT JOIN materias mat ON com.id_materia = mat.id
LEFT JOIN plan_materia pm ON mat.id = pm.materia_id
LEFT JOIN planes p ON pm.plan_id = p.id
LEFT JOIN carreras carr ON p.carrera_id = carr.id
LEFT JOIN cargos carg ON d.id = carg.docente_id
LEFT JOIN dedicaciones ded ON carg.dedicacion_id = ded.id

WHERE d.es_activo = true

--- 1. ESTRUCTURA (FILTROS DE_INSTITUTO Y DE_CARRERA) ---
AND ($P{OP_DE_INSTITUTO} IS NULL OR 
    ($P{OP_DE_INSTITUTO} = 'equals' AND carr.instituto_id = CAST($P{VALOR_DE_INSTITUTO} AS INTEGER)) OR
    ($P{OP_DE_INSTITUTO} = 'not_equals' AND carr.instituto_id != CAST($P{VALOR_DE_INSTITUTO} AS INTEGER)))

AND ($P{OP_DE_CARRERA} IS NULL OR 
    ($P{OP_DE_CARRERA} = 'equals' AND carr.id = CAST($P{VALOR_DE_CARRERA} AS INTEGER)) OR
    ($P{OP_DE_CARRERA} = 'not_equals' AND carr.id != CAST($P{VALOR_DE_CARRERA} AS INTEGER)))

--- 2. CARGA HORARIA ---
AND (
    $P{OP_HORAS} IS NULL OR 
    (
        '$P!{OP_HORAS}' = 'equals' AND d.carga_horaria = $P{VALOR_HORAS} OR
        '$P!{OP_HORAS}' = 'not_equals' AND d.carga_horaria != $P{VALOR_HORAS} OR
        '$P!{OP_HORAS}' = 'greater' AND d.carga_horaria > $P{VALOR_HORAS} OR
        '$P!{OP_HORAS}' = 'less' AND d.carga_horaria < $P{VALOR_HORAS} OR
        '$P!{OP_HORAS}' = 'between' AND d.carga_horaria BETWEEN $P{MIN_HORAS} AND $P{MAX_HORAS}
    )
)

--- 3. LEGAJO ---
AND (
    $P{OP_LEGAJO} IS NULL OR 
    (
        '$P!{OP_LEGAJO}' = 'equals' AND d.legajo = $P{VALOR_LEGAJO} OR
        '$P!{OP_LEGAJO}' = 'not_equals' AND d.legajo != $P{VALOR_LEGAJO} OR
        '$P!{OP_LEGAJO}' = 'greater' AND d.legajo > $P{VALOR_LEGAJO} OR
        '$P!{OP_LEGAJO}' = 'less' AND d.legajo < $P{VALOR_LEGAJO} OR
        '$P!{OP_LEGAJO}' = 'between' AND d.legajo BETWEEN $P{MIN_LEGAJO} AND $P{MAX_LEGAJO}
    )
)

--- 4. CARGOS ---
AND (
    $P{OP_CARGO} IS NULL OR
    ($P{OP_CARGO} = 'contains' AND carg.nombre ILIKE '%' || CAST($P{VALOR_CARGO} AS TEXT) || '%') OR
    ($P{OP_CARGO} = 'equals' AND carg.nombre = CAST($P{VALOR_CARGO} AS TEXT))
)

--- 5. DEDICACIÓN ---
AND (
    $P{OP_DEDICACION} IS NULL OR
    ($P{OP_DEDICACION} = 'equals' AND ded.id = $P{VALOR_DEDICACION})
)

--- 6. MODALIDAD ---
AND (
    $P{OP_MODALIDAD} IS NULL OR
    ($P{OP_MODALIDAD} = 'equals' AND d.modalidad_desempeño = CAST($P{VALOR_MODALIDAD} AS TEXT))
)

--- 7. MATERIA ---
AND (
    $P{OP_MATERIA} IS NULL OR
    ($P{OP_MATERIA} = 'contains' AND mat.nombre ILIKE '%' || CAST($P{VALOR_MATERIA} AS TEXT) || '%') OR
    ($P{OP_MATERIA} = 'equals' AND mat.nombre = CAST($P{VALOR_MATERIA} AS TEXT))
)

--- 8. NOMBRE / APELLIDO ---
AND (
    $P{OP_NOMBRE} IS NULL OR
    ($P{OP_NOMBRE} = 'contains' AND (d.nombre ILIKE '%' || CAST($P{VALOR_NOMBRE} AS TEXT) || '%' OR d.apellido ILIKE '%' || CAST($P{VALOR_NOMBRE} AS TEXT) || '%')) OR
    ($P{OP_NOMBRE} = 'equals' AND (d.nombre = CAST($P{VALOR_NOMBRE} AS TEXT) OR d.apellido = CAST($P{VALOR_NOMBRE} AS TEXT)))
)

GROUP BY d.id, d.legajo, d.apellido, d.nombre, d.modalidad_desempeño, d.carga_horaria
ORDER BY d.apellido ASC, d.nombre ASC]]>
    </queryString>
